# ── Database ──────────────────────────────────────────────────────────────
# Any managed Postgres works: Neon, Supabase, Railway, RDS, or local Docker.
# Free-tier options: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/glimore?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── App ───────────────────────────────────────────────────────────────────
# Used for cookie domain rules, absolute URLs in emails, and CSRF origin checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Razorpay ──────────────────────────────────────────────────────────────
# From https://dashboard.razorpay.com/app/keys — use TEST keys until you've
# gone through Razorpay activation/KYC for LIVE keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Public copy for the client-side checkout widget (safe to expose — it's an ID, not a secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# From Razorpay Dashboard → Settings → Webhooks, after you add the webhook URL
# {NEXT_PUBLIC_APP_URL}/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Seed admin (used only by prisma/seed.ts) ────────────────────────────────
SEED_ADMIN_EMAIL="admin@glimorefragrances.com"
SEED_ADMIN_PASSWORD="change-this-immediately"
