# ── Database ──────────────────────────────────────────────────────────────
# On Vercel: Project → Storage → Create Database → Neon. The integration sets
# DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct) automatically.
# `npm run vercel-build` runs migrations over the unpooled URL and seeds an empty DB.
# Locally: any Postgres works.
DATABASE_URL="postgresql://user:password@host:5432/glimore?schema=public"
# Optional direct (non-pooled) URL used for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# ── Auth ──────────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── App ───────────────────────────────────────────────────────────────────
# Used for cookie domain rules, absolute URLs in emails, and CSRF origin checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Razorpay ──────────────────────────────────────────────────────────────
# From https://dashboard.razorpay.com/app/keys — use TEST keys until you've
# gone through Razorpay activation/KYC for LIVE keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Public copy for the client-side checkout widget (safe to expose — it's an ID, not a secret).
# Must be the SAME value as RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# From Razorpay Dashboard → Settings → Webhooks, after you add the webhook URL
# {NEXT_PUBLIC_APP_URL}/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Email (OTP codes, welcome, password reset, order confirmations) ──────────
# Brevo free plan: 300 emails/day, no custom domain needed — verify a single
# sender address (e.g. your Gmail) under Senders, then create an API key under
# SMTP & API → API Keys.
BREVO_API_KEY=""
EMAIL_FROM="you@gmail.com"
EMAIL_FROM_NAME="Glimoré Fragrances"
# Alternative once you own a domain: RESEND_API_KEY="re_..." (EMAIL_PROVIDER=resend)
# With no key, emails are printed to the server console in dev. In production with
# no key, new accounts are auto-verified (no OTP) so signups never get stuck.
# EMAIL_PROVIDER="console"   # force console output (testing)

# ── Seed admin (used by prisma/seed.ts and the Vercel build) ──────────────────
# The admin is created only if BOTH are set and the email has no account yet.
# Password: 10+ characters with letters and numbers. Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
